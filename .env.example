# ─────────────────────────────────────────────────────────────────────────────
# Serene Admin — content admin panel for tranquilsrilanka.com
#
# Copy to .env.local for local development:   cp .env.example .env.local
# On Vercel: Project → Settings → Environment Variables (Production + Preview),
# then redeploy — new values only apply to the next deployment.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# MongoDB connection string — the same database the public website reads from.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority

# ── Admin login (required — nobody can sign in until all three are set) ──────
ADMIN_USERNAME=admin
# Use a strong, unique password (16+ characters).
ADMIN_PASSWORD=
# Signs the login cookie. Random, at least 32 characters. Changing it signs
# every device out. Use a different value from SITE_REVALIDATE_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_SESSION_SECRET=

# ── Image uploads (required) ─────────────────────────────────────────────────
# Cloudinary → Dashboard → API Keys. Uploads go to the "serene-sri-lanka" folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Refresh the public website after edits (recommended) ─────────────────────
# Without these, edits still save but take up to an hour to appear on the site.
SITE_URL=https://www.tranquilsrilanka.com
# Must be exactly the same value as REVALIDATE_SECRET on the website project.
SITE_REVALIDATE_SECRET=

# ── Set automatically — do not add ───────────────────────────────────────────
# NODE_ENV     set by Next.js

# ── No longer used — safe to delete from .env.local / Vercel ─────────────────
# MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASS, MAIL_FROM   (the admin panel sends no email)
